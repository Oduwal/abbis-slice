{
  "name": "abbis-slice",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first blood unit traceability, inventory and explainable shortage/expiry forecasting. Synthetic data only.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "seed": "node --experimental-strip-types --no-warnings src/synthetic/seed.ts",
    "start": "node --experimental-strip-types --no-warnings src/server.ts",
    "start:hospital": "node --env-file=hospital.env --experimental-strip-types --no-warnings src/server.ts",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "eval": "node --experimental-strip-types --no-warnings src/ai/evaluate.ts"
  }
}
